{
  "schemaVersion": 1,
  "localizationFrameworkVersion": 2,
  "site": {
    "brand": "LEYA MOULD",
    "origin": "https://leyamould.com",
    "defaultLocale": "en",
    "publishedLocales": ["en", "es"],
    "indexingApproved": false
  },
  "cloudflare": {
    "pagesProjectName": "leyamould",
    "productionBranch": "main",
    "d1Database": "leyamould-d1",
    "d1Binding": "LEYA_DB",
    "r2Bucket": "leyamould-r2",
    "r2Binding": "LEYA_ASSETS",
    "r2OverflowBucket": "leyamould-model-pages",
    "r2OverflowBinding": "LEYA_MODEL_PAGES"
  },
  "build": {
    "source": "source-controlled templates/site plus product/blog datasets",
    "output": "dist",
    "warningFiles": 16000,
    "overflowTargetFiles": 15500,
    "hardLimitFiles": 19500
  }
}

